# ===================================================
# E-Commerce AI Assistant Environment Configuration
# ===================================================

# MySQL Database Configuration
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=ecommerce_db

# LLM API Configuration
# Get your Gemini API key from https://aistudio.google.com/
GEMINI_API_KEY=

# (Optional) OpenAI API Key alternative from https://platform.openai.com/
OPENAI_API_KEY=

# Active LLM Provider: 'gemini', 'openai', or 'auto' (detects available key)
LLM_PROVIDER=auto

# Model Name
# Gemini models: gemini-1.5-flash, gemini-2.0-flash, gemini-1.5-pro
# OpenAI models: gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-1.5-flash

# Flask Server Configuration
FLASK_ENV=development
FLASK_DEBUG=True
PORT=5000
SECRET_KEY=your_flask_secret_key_here

# Power BI Integration Configuration
# Option 1: Direct 'Publish to Web' Embed URL from Power BI Service
POWERBI_EMBED_URL=

# Option 2: Power BI Embedded Service Principal Details (Optional)
POWERBI_REPORT_ID=
POWERBI_WORKSPACE_ID=
POWERBI_TENANT_ID=
POWERBI_CLIENT_ID=
POWERBI_CLIENT_SECRET=
